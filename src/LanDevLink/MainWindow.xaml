<Window x:Class="LanDevLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="LanDevLink"
        Width="1060"
        Height="730"
        MinWidth="900"
        MinHeight="650"
        Icon="Assets/LanDevLink.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FFE2E2E7" BorderThickness="1" CornerRadius="12" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,10,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Source="Assets/LanDevLink.ico" Stretch="Uniform" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LanDevLink" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="内网开发直链" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DiagnosticsNavButton" Margin="0,0,10,0" Content="网络诊断" Style="{StaticResource SecondaryButton}"
                            Padding="14,8" MinHeight="36"
                            AutomationProperties.Name="打开网络诊断" Click="ShowDiagnostics_Click" />
                    <Button Content="—" Style="{StaticResource ChromeButton}" ToolTip="最小化"
                            AutomationProperties.Name="最小化窗口" Click="Minimize_Click" />
                    <Button Content="□" Style="{StaticResource ChromeButton}" ToolTip="最大化或还原"
                            AutomationProperties.Name="最大化或还原窗口" Click="Maximize_Click" />
                    <Button Content="×" Style="{StaticResource ChromeButton}" ToolTip="关闭"
                            AutomationProperties.Name="关闭窗口" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ShareView" Grid.Row="1" Margin="32,18,32,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" MinWidth="350" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="1.08*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="把本机项目分享出去" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,28"
                                   Text="同一网络中的同事无需安装任何工具，打开链接即可预览。"
                                   FontSize="15" LineHeight="23" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

                        <TextBlock Text="本机服务地址" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppleTextBox}" IsEnabled="{Binding IsInactive}"
                                 AutomationProperties.Name="本机服务地址" />
                        <TextBlock Margin="0,7,0,0" Text="仅允许 localhost、127.0.0.1 或 ::1。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发现的服务" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DiscoveredServices}" SelectedItem="{Binding SelectedService}"
                                          Style="{StaticResource AppleComboBox}" IsEnabled="{Binding IsInactive}"
                                          AutomationProperties.Name="发现的本机服务" />
                            </StackPanel>
                            <Button Grid.Column="2" Margin="0,25,0,0" Content="重新扫描"
                                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsInactive}" Click="Scan_Click" />
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="访问密码（可选）" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="SharePasswordBox" Style="{StaticResource ApplePasswordBox}"
                                             MaxLength="128" IsEnabled="{Binding IsInactive}"
                                             AutomationProperties.Name="访问密码" PasswordChanged="SharePassword_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分享时长（可选）" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ShareDurationOptions}"
                                          SelectedItem="{Binding SelectedShareDuration}" DisplayMemberPath="Label"
                                          Style="{StaticResource AppleComboBox}" IsEnabled="{Binding IsInactive}"
                                          AutomationProperties.Name="分享时长" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,22,0,0" Padding="14,12" Background="#FFFFFFFF"
                                BorderBrush="#FFE2E2E7" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="访问控制" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0" Text="密码留空且选择不限时，即保持当前直接访问、手动停止的方式。"
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="12,10" Background="#FFFFF2F3"
                                BorderBrush="#FFFFC7CD" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       FontSize="13" TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="StartShareButton" Margin="0,24,0,0" Content="{Binding StartButtonText}"
                                Style="{StaticResource AppleButton}" IsEnabled="{Binding CanStart}"
                                IsDefault="True" Click="StartShare_Click" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#FFE2E2E7"
                        BorderThickness="1" CornerRadius="8" Padding="32">
                    <Grid>
                        <Grid Visibility="{Binding IsInactive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="准备分享" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="选择左侧的本机服务并开始分享，访问链接和二维码会显示在这里。"
                                           FontSize="14" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,24,0,0" Padding="16,14" Background="#FFEAF3FC" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="无法访问别人分享的链接？" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0" Text="使用窗口顶部的“网络诊断”检查当前网络和目标端口。"
                                                   FontSize="12" LineHeight="19" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border HorizontalAlignment="Left" Background="#FFEAF6ED" CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0" Text="分享中" Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="0,16,0,0" Text="项目已可访问" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding ShareAccessText}"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ShareUrl, Mode=OneWay}" Style="{StaticResource AppleTextBox}"
                                         IsReadOnly="True" AutomationProperties.Name="分享链接" />
                                <Button Grid.Column="2" Content="复制链接" Style="{StaticResource AppleButton}" Click="CopyLink_Click" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,28,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="10" BorderBrush="#FFE2E2E7" BorderThickness="1" CornerRadius="8">
                                    <Image Width="174" Height="174" Source="{Binding QrCode}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="访问概况" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Margin="0,16,0,0" Text="独立访问设备" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding VisitorCountText}" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,16,0,0" Text="分享状态" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding ShareStatusText}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="3" Content="停止分享" Style="{StaticResource DangerButton}" Click="StopShare_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DiagnosticsView" Grid.Row="1" Margin="32,18,32,22" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="返回分享" Style="{StaticResource SecondaryButton}" Padding="14,8" MinHeight="40"
                            AutomationProperties.Name="返回分享界面" Click="ShowShare_Click" />
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="网络诊断" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0" Text="检查分享链接是否与本机处于同一网络，以及目标端口是否可连接。"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" MinWidth="420" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="0.92*" MinWidth="350" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#FFE2E2E7"
                            BorderThickness="1" CornerRadius="8" Padding="32">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel KeyboardNavigation.TabNavigation="Local">
                                <TextBlock Text="检测分享链接" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,22"
                                           Text="粘贴别人分享给你的链接，诊断会检查地址、子网和端口连接。"
                                           FontSize="14" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="别人分享的链接" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DiagnosticUrlTextBox"
                                         Text="{Binding DiagnosticUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AppleTextBox}"
                                         AutomationProperties.Name="别人分享的链接" />
                                <Button x:Name="DiagnosticActionButton" Margin="0,12,0,0" Content="{Binding DiagnosticButtonText}"
                                        Style="{StaticResource AppleButton}" IsEnabled="{Binding CanDiagnose}"
                                        AutomationProperties.Name="检测分享链接" Click="Diagnose_Click" />

                                <Border Margin="0,18,0,0" Padding="14,12" Background="#FFEAF3FC"
                                        CornerRadius="8"
                                        Visibility="{Binding HasDiagnosticResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DiagnosticResultTitle}" FontSize="14"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,7,0,0" Text="{Binding DiagnosticResultDetails}"
                                                   FontSize="12" LineHeight="19" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#FFE2E2E7"
                            BorderThickness="1" CornerRadius="8" Padding="32">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前网络" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,12,0" Text="{Binding NetworkStatusMessage}"
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}"
                                            Padding="14,8" MinHeight="40"
                                            AutomationProperties.Name="刷新当前网络信息" Click="RefreshNetwork_Click" />
                                </Grid>

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding NetworkConnections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding AddressText}" FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#FFE2E2E7" BorderThickness="0,1,0,0">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding StatusMessage}"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="控制面板仅在本机运行" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
